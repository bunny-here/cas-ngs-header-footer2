{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Midnight",
	"settings": {
		"color": {
			"duotone": [
				{
					"colors": [
						"#1A1612",
						"#E6CCB2"
					],
					"name": "Midnight filter",
					"slug": "midnight-filter"
				}
			],
			"palette": [
				{
					"color": "#F8F6F0",
					"name": "Canvas Background",
					"slug": "base"
				},
				{
					"color": "#1A1612",
					"name": "Warm Ink",
					"slug": "contrast"
				},
				{
					"color": "#865438",
					"name": "Dark Earth",
					"slug": "accent-1"
				},
				{
					"color": "#AF7853",
					"name": "Copper",
					"slug": "accent-2"
				},
				{
					"color": "#D4996E",
					"name": "Sand",
					"slug": "accent-3"
				},
				{
					"color": "#E6CCB2",
					"name": "Beige Linen",
					"slug": "accent-4"
				},
				{
					"color": "#EDE0D4",
					"name": "Alabaster",
					"slug": "accent-5"
				},
				{
					"color": "rgba(134, 84, 56, 0.18)",
					"name": "Bronze Border Fade",
					"slug": "accent-6"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/code": {
				"color": {
					"background": "var:preset|color|accent-2",
					"text": "var:preset|color|contrast"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						}
					}
				}
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--contrast) 85%, transparent)"
					}
				}
			}
		},
		"variations": {
			"section-1": {
				"color": {
					"text": "var:preset|color|accent-3"
				},
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|accent-3",
							"text": "var:preset|color|accent-5"
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--accent-3) 85%, transparent)"
							}
						}
					},
					"link": {
						"color": {
							"text": "currentColor"
						}
					}
				}
			},
			"section-4": {
				"color": {
					"text": "var:preset|color|accent-5"
				},
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|accent-5",
							"text": "var:preset|color|accent-3"
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--accent-5) 85%, transparent)"
							}
						}
					},
					"link": {
						"color": {
							"text": "currentColor"
						}
					}
				}
			}
		},
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		}
	}
}
