{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Evening",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#F8F6F0",
					"name": "Canvas Background",
					"slug": "base"
				},
				{
					"color": "#1A1612",
					"name": "Warm Ink",
					"slug": "contrast"
				},
				{
					"color": "#865438",
					"name": "Dark Earth",
					"slug": "accent-1"
				},
				{
					"color": "#AF7853",
					"name": "Copper",
					"slug": "accent-2"
				},
				{
					"color": "#D4996E",
					"name": "Sand",
					"slug": "accent-3"
				},
				{
					"color": "#E6CCB2",
					"name": "Beige Linen",
					"slug": "accent-4"
				},
				{
					"color": "#EDE0D4",
					"name": "Alabaster",
					"slug": "accent-5"
				},
				{
					"color": "rgba(134, 84, 56, 0.18)",
					"name": "Bronze Border Fade",
					"slug": "accent-6"
				}
			]
		}
	},
	"styles": {
		"color": {
			"text": "var:preset|color|contrast",
			"background": "var:preset|color|base"
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"spacing": {
							"padding": {
								"bottom": "0.6rem",
								"left": "1.6rem",
								"right": "1.6rem",
								"top": "0.6rem"
							}
						}
					}
				}
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--contrast) 85%, transparent)",
						"text": "var:preset|color|base"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "0.6rem",
						"left": "1.6rem",
						"right": "1.6rem",
						"top": "0.6rem"
					}
				}
			}
		},
		"variations": {
			"section-2": {
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|base",
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--base) 85%, transparent)"
							}
						}
					}
				}
			},
			"section-4": {
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|accent-2",
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--accent-2) 85%, transparent)"
							}
						}
					}
				}
			}
		}
	}
}
